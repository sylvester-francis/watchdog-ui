{
  "name": "@sylvester-francis/watchdog-ui",
  "version": "0.1.6",
  "description": "Design primitives for Watchdog and downstream consumers — Svelte 5 components driven by typed design tokens.",
  "license": "AGPL-3.0",
  "author": "Sylvester Francis",
  "homepage": "https://github.com/sylvester-francis/watchdog-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylvester-francis/watchdog-ui.git"
  },
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && svelte-package",
    "build:tokens": "bun scripts/build-tokens.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "svelte-kit sync && storybook dev -p 6006",
    "build-storybook": "svelte-kit sync && storybook build",
    "prepublishOnly": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./tokens/watchdog": {
      "types": "./dist/tokens/watchdog.d.ts",
      "default": "./dist/tokens/watchdog.js"
    },
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/svelte": "^10.3.6",
    "@storybook/svelte-vite": "^10.3.6",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.0.0",
    "lucide-svelte": "^0.460.0",
    "storybook": "^10.3.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
